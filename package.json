{
  "name": "discord-reader-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server exposing the Discord REST API as tools",
  "main": "dist/functions/*.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prestart": "pnpm build",
    "start": "func start",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@azure/functions": "4.17.0",
    "@discordjs/rest": "2.6.3",
    "@jmespath-community/jmespath": "1.5.0",
    "@modelcontextprotocol/server": "2.4.0",
    "discord-api-types": "0.38.58",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.118",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "azure-functions-core-tools": "4.16.0",
    "eslint": "10.14.0",
    "only-allow": "1.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
